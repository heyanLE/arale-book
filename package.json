{
  "name": "aralebook",
  "version": "0.1.0",
  "private": true,
  "description": "あられブック (ARaLeBook) — desktop-only Calibre-style manager and reader for comics and novels, with Japanese segmentation and click-to-lookup popup dictionary.",
  "scripts": {
    "tauri:dev": "node scripts/tauri.mjs dev",
    "tauri:build": "node scripts/tauri.mjs build",
    "tauri:pack": "node scripts/tauri.mjs pack",
    "tauri:check": "node scripts/tauri.mjs check",
    "tauri:test": "node scripts/tauri.mjs test",
    "tauri:smoke": "node scripts/smoke-tauri.mjs",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build:renderer": "vite build",
    "build": "node scripts/tauri.mjs build",
    "start": "node scripts/tauri.mjs dev",
    "test": "node scripts/test.mjs",
    "test:only": "node --test \"dist-test/tests/*.test.js\"",
    "smoke": "node scripts/smoke-tauri.mjs",
    "test:all": "node scripts/test.mjs && node scripts/tauri.mjs test && node scripts/test-tauri-services.mjs && node scripts/test-tauri-ocr.mjs && node scripts/test-tauri-study.mjs && node scripts/smoke-tauri.mjs",
    "build:native": "node scripts/build-native.mjs",
    "build:all": "node scripts/tauri.mjs build",
    "native:test": "cd native/arale-native && cargo test",
    "test:native": "node scripts/test-native.mjs",
    "icon": "node scripts/make-icon.mjs",
    "pack": "node scripts/tauri.mjs pack",
    "pack:release": "node scripts/tauri.mjs pack",
    "build:vision-ocr": "node scripts/build-vision-ocr.mjs",
    "icon:export": "node scripts/make-icon.mjs --export",
    "tauri:services:test": "node scripts/test-tauri-services.mjs",
    "tauri:ocr:test": "node scripts/test-tauri-ocr.mjs",
    "tauri:study:test": "node scripts/test-tauri-study.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "fast-xml-parser": "^4.5.1",
    "fflate": "^0.8.2",
    "kuromoji": "0.1.2",
    "marked": "^18.0.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "1.4.11",
    "@vitejs/plugin-react": "^4.3.4",
    "7z-wasm": "1.2.0",
    "esbuild": "^0.28.2",
    "kuroshiro-analyzer-kuromoji": "^1.1.0",
    "sql.js": "1.14.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
