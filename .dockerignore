# Allow only build inputs. Every traversed parent excludes its other children again.
**
!package.json
!package-lock.json
!scripts
scripts/*
!scripts/build-server.mjs
!src
src/*
!src/core
!src/core/**
!src/shared
!src/shared/**
!server
server/*
!server/src
!server/src/**
!server/docker
server/docker/*
!server/docker/*.py
!server/docker/*.json
!server/docker/*.sh
!server/docker/*.lock
!server/Dockerfile
!native
native/*
!native/arale-native
native/arale-native/*
!native/arale-native/Cargo.toml
!native/arale-native/Cargo.lock
!native/arale-native/src
!native/arale-native/src/**
!engines
engines/*
!engines/LICENSE
!engines/arale_onnx_v1
engines/arale_onnx_v1/*
!engines/arale_onnx_v1/python
!engines/arale_onnx_v1/python/**
!engines/arale_onnx_v1/model-manifest.json
!engines/arale_onnx_v1/THIRD_PARTY.md
!engines/arale_onnx_v1/dist
engines/arale_onnx_v1/dist/*
!engines/arale_onnx_v1/dist/catalog-entry-darwin-arm64.json
!engines/arale_onnx_v1/models
engines/arale_onnx_v1/models/*
!engines/arale_onnx_v1/models/detector.onnx
!engines/arale_onnx_v1/models/manga-ocr-encoder.onnx
!engines/arale_onnx_v1/models/manga-ocr-decoder-init.onnx
!engines/arale_onnx_v1/models/manga-ocr-decoder-step.onnx
!engines/arale_onnx_v1/models/vocab.txt
# Defense against generated artifacts inside otherwise allowed source directories.
**/__pycache__
**/*.pyc
**/target
**/node_modules
**/build
**/runtime
**/.git
**/.env
