# Copy to server/.env, then docker compose -f server/compose.yaml up -d --build
ARALE_PLATFORM=linux/amd64
ARALE_IMAGE=arale-server:local
ARALE_LIBRARY_DIR=../server-library
ARALE_PORT=3737
ARALE_BIND_ADDRESS=0.0.0.0
ARALE_SERVER_NAME=Arale Server
ARALE_OCR_THREADS=4
ARALE_UID=1000
ARALE_GID=1000
# Credentials are generated in /data/access-token, never baked into the image.
